# Python
__pycache__/
*.pyc
.venv/
venv/

# Everything exported into datasets/ (CSV, parquet, Excel, whatever format
# comes next) stays local until deliberately processed/curated - only the
# license file is meant to be tracked here. Blanket-ignore + explicit
# allowlist instead of listing extensions one by one, so a new export format
# can't slip through uncovered.
datasets/*
!datasets/LICENSE

# Editor and OS files
.idea/
.vscode/*
!.vscode/extensions.json
.claude/
.DS_Store
dev-history-commits.sh
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
october-history-commits.sh

# Trained models and out-of-fold predictions: they embed or reference student
# sessions (TabPFN keeps its whole training set as context), so they stay local
# like the datasets. Aggregate metrics in */results/ are tracked.
ml/**/artifacts/
# Local backdating scripts (run by hand, never committed)
*-history-commits.sh

# Backups pulled from the production VPS (DB dump with student data + secrets)
server-backup/

# Thesis-only material, not part of the system: exploratory analysis (EDA)
# and the figures generated for the thesis text
ml/eda/
ml/evaluation/figures/
ml/evaluation/figures.py
