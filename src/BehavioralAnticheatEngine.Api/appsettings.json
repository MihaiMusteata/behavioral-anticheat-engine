{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=behavioral_anticheat;Username=postgres;Password=postgres"
  },
  "Redis": {
    "Configuration": "localhost:6379"
  },
  "Kafka": {
    "BootstrapServers": "localhost:19092",
    "BehavioralEventsTopic": "behavioral-events",
    "ConsumerGroupId": "behavioral-anticheat-worker"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317",
    "Environment": "development"
  },
  "BehavioralIngestion": {
    "AcceptedClockSkewSeconds": 120,
    "NonceTtlSeconds": 600,
    "LargeSequenceGapThreshold": 20,
    "MaxEventsPerMinute": 240,
    "EventSilenceSeconds": 60,
    "MaxBatchSize": 100,
    "MaxEncryptedDataLength": 90000
  },
  "RiskScoring": {
    "Rules": {
      "window_blur_count": 3,
      "visibility_hidden_count": 5,
      "copy_count": 4,
      "cut_count": 4,
      "paste_count": 7,
      "fullscreen_exit_count": 10,
      "window_resize_count": 3,
      "right_click_count": 2,
      "keyboard_shortcut_count": 6,
      "text_burst_detected_count": 12,
      "devtools_heuristic_triggered_count": 18,
      "print_attempt_count": 10,
      "idle_detected_count": 2,
      "multiple_tabs_detected_count": 14,
      "page_reload_count": 4,
      "page_unload_count": 4,
      "event_validation_failed_count": 15,
      "event_sequence_gap_count": 8,
      "event_silence_detected_count": 8
    }
  },
  "Jwt": {
    "AccessToken": {
      "Issuer": "BehavioralAnticheatEngine",
      "Audience": "BehavioralAnticheatEngine.Api",
      "SigningKey": "development-access-token-signing-key-change-before-production",
      "LifetimeMinutes": 15,
      "ClockSkewSeconds": 30
    },
    "RefreshToken": {
      "Issuer": "BehavioralAnticheatEngine.Refresh",
      "Audience": "BehavioralAnticheatEngine.Api.Refresh",
      "SigningKey": "development-refresh-token-signing-key-change-before-production",
      "LifetimeMinutes": 10080,
      "ClockSkewSeconds": 30
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
