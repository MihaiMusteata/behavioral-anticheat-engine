# Copy this file to `.env` (same directory as docker-compose.yml) and fill
# in real, unique values before ever exposing this stack through ngrok or
# any other public tunnel for a real exam. `.env` is gitignored - it is
# never committed. Without a `.env` file, docker-compose falls back to the
# dev-only placeholder values baked into docker-compose.yml, which is fine
# for local-only use but NOT safe once the stack is reachable from the
# internet (anyone who reads this public repo knows those placeholders).

# Postgres password (used by the postgres, api, worker and postgres-exporter services).
POSTGRES_PASSWORD=choose-a-real-password

# JWT signing keys - generate long random strings, e.g. `openssl rand -base64 48`.
JWT_ACCESS_SIGNING_KEY=choose-a-real-random-access-token-signing-key
JWT_REFRESH_SIGNING_KEY=choose-a-real-random-refresh-token-signing-key

# Seeded admin/student account passwords.
SEED_ADMIN_PASSWORD=choose-a-real-admin-password
SEED_STUDENT_PASSWORD=choose-a-real-student-password

# Grafana admin password (operator-only UI, not tunneled - see docker-compose.yml).
GRAFANA_ADMIN_PASSWORD=choose-a-real-grafana-password
